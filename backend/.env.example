# =====================================================
# APP
# =====================================================
APP_NAME=AIFlow
APP_ENV=development
DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Log level (DEBUG/INFO/WARNING/ERROR). Format (JSON vs. readable text) is
# derived from APP_ENV, not configured separately - see ARCHITECTURE.md.
LOG_LEVEL=INFO

# =====================================================
# DATABASE — Neon PostgreSQL
# Create a free project at https://neon.tech and paste its connection
# string here. Any standard Postgres connection string works.
# =====================================================
DATABASE_URL=postgresql://<user>:<password>@<your-project>.neon.tech/<database>?sslmode=require

# =====================================================
# JWT
# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================
JWT_SECRET=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# =====================================================
# AI — provider-agnostic. Set LLM_PROVIDER to pick which of the four
# adapters below actually handles chat requests. Only that provider's
# section needs real values; the other three can stay blank — the app
# only validates the credentials the SELECTED provider needs, at startup.
# See ARCHITECTURE.md for how providers are selected and swapped.
# =====================================================
LLM_PROVIDER=groq  # groq | gemini | openrouter | ollama

# Optional single-attempt fallback: on a transient failure of the primary
# provider (rate limit / timeout / temporarily unavailable), retry once
# against this provider instead of failing the request. Leave blank (or
# "none") to disable — this is off by default. Never retries more than
# once, and never falls back for invalid requests, auth problems, or a
# prompt-injection refusal - those aren't provider failures.
LLM_FALLBACK_PROVIDER=

# The model id passed to whichever provider is selected (meaning is
# provider-specific — see each section below for real example values).
LLM_MODEL=openai/gpt-oss-20b

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=  # blank = Groq's real endpoint (https://api.groq.com/openai/v1)
# Example model: LLM_MODEL=openai/gpt-oss-20b

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
# Example model: LLM_MODEL=gemini-2.0-flash

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=  # blank = OpenRouter's real endpoint (https://openrouter.ai/api/v1)
# Example model: LLM_MODEL=openai/gpt-4o-mini (any OpenRouter model id — tool
# calling only works if the chosen model supports it)

# --- Ollama (local, no API key) ---
# Install: https://ollama.com/download, then `ollama pull llama3.1` (or any
# tool-calling-capable model) and leave the server running (`ollama serve`,
# usually started automatically). Not required unless LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Example model: LLM_MODEL=llama3.1

# Legacy fields from before multi-provider support. Still read as a
# fallback by the Groq adapter if GROQ_API_KEY/GROQ_BASE_URL aren't set,
# so an existing .env keeps working unchanged — new setups should use
# GROQ_API_KEY above instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# =====================================================
# NOTIFICATIONS (optional — dev falls back to console logging)
# =====================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# =====================================================
# CALENDAR (Google OAuth — optional)
# =====================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# =====================================================
# GMAIL (Google OAuth — optional)
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above - register BOTH
# redirect URIs (this one and GOOGLE_REDIRECT_URI) on the same OAuth
# client in Google Cloud Console. See ARCHITECTURE.md's "Gmail
# integration" section for exact setup steps, scopes, and consent-screen
# configuration.
# =====================================================
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback

# =====================================================
# WHATSAPP / INSTAGRAM CHANNELS (Meta — optional)
# App-level secrets only - see app/config.py for what these are and why a
# business's own WhatsApp number/Instagram account isn't configured here
# (it's per-tenant data in the database, set from Settings → Integrations).
# Required before any inbound webhook is trusted; the app runs fine without
# them, it just can't verify Meta webhooks yet.
# =====================================================
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# =====================================================
# CORS
# =====================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
