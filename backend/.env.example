# =====================================================
# APP
# =====================================================
APP_NAME=AIFlow
APP_ENV=development
DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Log level (DEBUG/INFO/WARNING/ERROR). Format (JSON vs. readable text) is
# derived from APP_ENV, not configured separately - see ARCHITECTURE.md.
LOG_LEVEL=INFO

# =====================================================
# DATABASE — Neon PostgreSQL
# Create a free project at https://neon.tech and paste its connection
# string here. Any standard Postgres connection string works.
# =====================================================
DATABASE_URL=postgresql://<user>:<password>@<your-project>.neon.tech/<database>?sslmode=require

# =====================================================
# JWT
# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================
JWT_SECRET=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# =====================================================
# AI — any OpenAI-compatible provider (OpenAI, Groq, Together, Fireworks, ...)
# =====================================================
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# =====================================================
# NOTIFICATIONS (optional — dev falls back to console logging)
# =====================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# =====================================================
# CALENDAR (Google OAuth — optional)
# =====================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# =====================================================
# WHATSAPP / INSTAGRAM CHANNELS (Meta — optional)
# App-level secrets only - see app/config.py for what these are and why a
# business's own WhatsApp number/Instagram account isn't configured here
# (it's per-tenant data in the database, set from Settings → Integrations).
# Required before any inbound webhook is trusted; the app runs fine without
# them, it just can't verify Meta webhooks yet.
# =====================================================
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# =====================================================
# CORS
# =====================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
